# WHOOP Developer Dashboard credentials
# Get these at https://developer.whoop.com
WHOOP_CLIENT_ID=your_client_id_here
WHOOP_CLIENT_SECRET=your_client_secret_here

# Must EXACTLY match a Redirect URL registered in the WHOOP Developer Dashboard
WHOOP_REDIRECT_URI=http://localhost:3000/auth/whoop/callback

# Secret used to encrypt the session cookie (min 32 characters)
# Generate one with: openssl rand -base64 32
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_chars
